{
  "name": "librelist-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../docs/swagger/collections.yaml -o src/api/schema.d.ts",
    "spec:coverage": "node scripts/spec-coverage.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lezer/highlight": "^1.2.5",
    "@lucide/vue": "^1.52.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.104.1",
    "@tanstack/vue-table": "^9.2.6",
    "@tinymce/tinymce-vue": "^6.3.0",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "js-beautify": "^2.0.3",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "textversionjs": "^1.1.3",
    "tinymce": "^7.9.3",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-codemirror": "^6.1.1",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^24.13.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
